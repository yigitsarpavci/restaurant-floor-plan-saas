# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/seated"

# Secret used to sign session cookies. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Password for the built-in `admin` account. Required in production.
# (In development, if unset, the password defaults to "admin".)
ADMIN_PASSWORD=""

# Optional: password for the seeded `demo` restaurant (defaults to "demo1234")
# SEED_DEMO_PASSWORD=""
